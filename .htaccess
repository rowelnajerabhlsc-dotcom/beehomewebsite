# 1. Security: Block public directory browsing
Options -Indexes
Options +FollowSymlinks

# 2. Enable the rewriting engine
RewriteEngine On
RewriteBase /

# 3. If someone explicitly types /HTML/products.php, redirect them to /products
RewriteCond %{THE_REQUEST} \s/HTML/([^\s?]+)\.php [NC]
RewriteRule ^HTML/(.*)\.php$ /$1 [R=301,L]

# 4. If they type /products, secretly fetch the file from /HTML/products.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/HTML/$1.php -f
RewriteRule ^([^/]+)$ HTML/$1.php [L]
