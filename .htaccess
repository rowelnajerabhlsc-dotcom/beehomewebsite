# 1. Server Settings
Options -Indexes
Options +FollowSymlinks
Options -MultiViews

# 2. Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# ==========================================
# 3. CRITICAL: Stop Rewriting Real Files
# ==========================================
# If the requested path is a real file or real folder, do NOT touch it!
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ==========================================
# 4. RULES FOR HOME (Directly in Root Folder)
# ==========================================
RewriteRule ^$ home.php [L]
RewriteRule ^home/?$ home.php [L]

# Redirect explicit requests for root home.php to clean root domain
RewriteCond %{THE_REQUEST} \s/home\.php [NC]
RewriteRule ^home\.php$ / [R=301,L]

# ==========================================
# 5. RULES FOR /HTML/ SUBFOLDER PAGES
# ==========================================
# Redirect any direct browser entry of /HTML/xyz.php to just /xyz
RewriteCond %{THE_REQUEST} \s/HTML/([^\s?]+)\.php [NC]
RewriteRule ^HTML/(.*)\.php$ /$1 [R=301,L]

# Secretly match extensionless URLs to their file inside the HTML folder
RewriteCond %{DOCUMENT_ROOT}/HTML/$1.php -f
RewriteRule ^([^/]+)/?$ HTML/$1.php [L]
