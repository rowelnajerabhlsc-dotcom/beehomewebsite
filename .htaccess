# 1. Security: Block public directory browsing
Options -Indexes
Options +FollowSymlinks

# 2. Enable the rewriting engine
RewriteEngine On
RewriteBase /

# ==========================================
# AUTHENTICATION & FORM SUBMISSION BYPASS
# ==========================================
# Rule: If a user is sending form data (POST), do not rewrite or redirect anything.
RewriteCond %{REQUEST_METHOD} POST
RewriteRule ^ - [L]


# ==========================================
# RULES FOR HOME (Directly in Root)
# ==========================================

# Route your root domain (yoursite.com) and /home to home.php
RewriteRule ^$ home.php [L]
RewriteRule ^home$ home.php [L]

# Redirect explicit requests for /home.php to the clean domain root
RewriteCond %{THE_REQUEST} \s/home\.php [NC]
RewriteRule ^home\.php$ / [R=301,L]


# ==========================================
# RULES FOR PRODUCTS / OTHERS (In /HTML/ Folder)
# ==========================================

# Redirect explicit /HTML/xyz.php requests to /xyz (Only for clean GET views)
RewriteCond %{REQUEST_METHOD} !=POST
RewriteCond %{THE_REQUEST} \s/HTML/([^\s?]+)\.php [NC]
RewriteRule ^HTML/(.*)\.php$ /$1 [R=301,L]

# Secretly fetch all other clean URLs from the /HTML/ folder
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/HTML/$1.php -f
RewriteRule ^([^/]+)$ HTML/$1.php [L]
