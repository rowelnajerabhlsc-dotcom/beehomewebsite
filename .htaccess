# 1. Server Settings
Options -Indexes
Options +FollowSymlinks
Options -MultiViews

# 2. Enable Rewrite Engine
RewriteEngine On
RewriteBase /

# ==========================================
# 3. CANONICAL CLEAN URL REDIRECTS
# ==========================================
# These must run before the real-file stop below, because /HTML/*.php
# exists on disk. Keep them GET/HEAD only so form POST handlers are not
# turned into browser redirects.
RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+home\.php[?\s] [NC]
RewriteRule ^home\.php$ / [R=301,L]

RewriteCond %{REQUEST_METHOD} ^(?:GET|HEAD)$ [NC]
RewriteCond %{THE_REQUEST} \s/+HTML/([^?\s]+)\.php[?\s] [NC]
RewriteRule ^HTML/(.+)\.php$ /$1 [R=301,L]

# ==========================================
# 4. RULES FOR HOME (Directly in Root Folder)
# ==========================================
RewriteRule ^$ home.php [L]
RewriteRule ^home/?$ home.php [L]

# ==========================================
# 5. CRITICAL: Stop Rewriting Real Files
# ==========================================
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# ==========================================
# 6. RULES FOR /HTML/ SUBFOLDER PAGES
# ==========================================
# Secretly match extensionless URLs to their file inside the HTML folder
RewriteCond %{DOCUMENT_ROOT}/HTML/$1.php -f
RewriteRule ^([^/]+)/?$ HTML/$1.php [L]

# ==========================================
# 7. LOCK DOWN test_email.php
# ==========================================
# Only the ?token= path is allowed. The token must equal the
# server-side TEST_EMAIL_TOKEN (matched in PHP); here we just refuse
# any direct hit that doesn't at least carry a token query string.
RewriteCond %{QUERY_STRING} !token=
RewriteRule ^HTML/test_email\.php$ - [F,L]
