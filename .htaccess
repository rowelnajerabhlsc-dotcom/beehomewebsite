RewriteEngine On

# 1. Externally redirect direct requests for /folder/file to /file
RewriteCond %{THE_REQUEST} \s/folder/([^\s?]*) [NC]
RewriteRule ^folder/(.*)$ /$1 [R=301,L]

# 2. Internally rewrite /file to look into /folder/ and add .php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/folder/$1.php -f
RewriteRule ^([^/]+)$ folder/$1.php [L]

Options -Indexes